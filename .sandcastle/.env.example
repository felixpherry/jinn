# Fine-grained GitHub token, scoped ONLY to felixpherry/jinn.
# Repository permissions: Issues read/write, Contents read-only.
# Never use the broad token from gh auth token here.
GH_TOKEN=

# Long-lived Claude Code token from `claude setup-token` (starts with sk-ant-oat01-).
# Optional: without it, Sandcastle uses the seeded copy in auth/claude, which
# shares a rotating refresh token with your host login and breaks on rotation.
CLAUDE_CODE_OAUTH_TOKEN=
